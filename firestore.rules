rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && 
        request.auth.token.email == 'h1mfzap3@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAnimeTrack(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.episode is number && data.episode >= 0 && data.episode <= 5000
        && data.source is string && data.source.size() <= 100
        && data.status is string && data.status.size() <= 50;
    }

    // Anime Tracks collection
    match /anime_tracks/{trackId} {
      // Public read so visitors can see the showcase and live tracked anime
      allow read: if true;

      // Allow creating, updating and deleting anime tracks with structural validation
      allow create: if isValidId(trackId) && isValidAnimeTrack(request.resource.data);

      allow update: if isValidId(trackId) && isValidAnimeTrack(request.resource.data);

      allow delete: if isValidId(trackId);
    }

    // Custom Monitored Sites collection
    match /custom_sites/{siteId} {
      allow read: if true;
      allow create, update, delete: if isValidId(siteId);
    }
  }
}
